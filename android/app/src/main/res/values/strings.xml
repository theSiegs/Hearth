<?xml version="1.0" encoding="utf-8"?>
<!-- Text the Java side shows or says, translated in values-xx/strings.xml. Proper nouns (Hearth, Home Assistant, Google TV...) stay untranslated. -->
<resources>
    <!-- Home Assistant notifications over whatever is playing (HaNotificationOverlay) -->
    <string name="ha_notification_close">Close</string>
    <string name="ha_notification_test_message">Test notification from Hearth</string>

    <!-- The Home Assistant dashboard panel (HaPanelActivity) -->
    <string name="ha_panel_unreachable">Can\'t reach Home Assistant</string>
    <string name="ha_panel_not_set_up">Home Assistant panel isn\'t set up</string>
    <string name="ha_panel_not_set_up_detail">Add the Home Assistant address and an access token in Settings → Home Assistant.</string>

    <!-- The phone page that sends the Home Assistant address and token to the TV (HaSetupServer) -->
    <string name="ha_setup_title">Connect Hearth to Home Assistant</string>
    <string name="ha_setup_address_label">Home Assistant address</string>
    <string name="ha_setup_token_label">Long-lived access token</string>
    <string name="ha_setup_token_hint">Paste the token here</string>
    <string name="ha_setup_send">Send to TV</string>
    <string name="ha_setup_help">Create the token in Home Assistant while signed in as the user for this TV: profile, Security tab, Long-lived access tokens. It goes straight to the TV over your home network.</string>
    <string name="ha_setup_missing">Enter the Home Assistant address and the token.</string>
    <string name="ha_setup_sent_title">Sent to the TV</string>
    <string name="ha_setup_sent_detail">Hearth has the address and token. You can close this page.</string>

    <!-- Profile Pairing's cover card and first-match notice (ProfilePairingService) -->
    <string name="profile_pairing_opening">Opening %1$s as %2$s…</string>
    <string name="profile_pairing_no_match">No matching profile for %1$s. Choose one on the next screen.</string>
    <string name="profile_pairing_matched">Hearth opened %1$s as “%2$s” for %3$s. To change it: Hearth Settings → Profile Pairing.</string>
    <string name="profile_pairing_the_app">the app</string>

    <!-- A Google TV profile before Hearth has learned its name (ProfileUsers) -->
    <string name="profile_unnamed">Profile %1$d</string>

    <!-- System text: the notification popup, idle standby, the agent's notification, voice search -->
    <string name="popup_app_and_title">%1$s • %2$s</string>
    <string name="idle_sleep_warning">No activity: going to sleep in 1 minute. Press any button to stay on.</string>
    <string name="agent_channel_name">Hearth for this profile</string>
    <string name="agent_notification_text">Keeps Hearth\'s home in step with this profile</string>
    <string name="search_voice_prompt">Search films and shows</string>
    <string name="pin_unlocking">Entering the profile PIN…</string>
    <string name="pin_rejected_title">%1$s didn’t accept the saved PIN for “%2$s”</string>
    <string name="pin_rejected_body">Change PIN to update it in Hearth’s Settings, or Close to type it here yourself.</string>
    <string name="pin_locked_title">%1$s locked “%2$s”</string>
    <string name="pin_locked_body">Too many wrong PINs. Unlock the profile in the app, then update the PIN in Hearth’s Settings.</string>
    <string name="pin_screen_changed">%1$s’s PIN screen changed, so Hearth didn’t type the PIN. Please type it yourself.</string>
    <string name="pin_broken_digits">Hearth stopped after %1$d digits. Please clear them and type the PIN yourself.</string>
    <string name="pin_broken">Hearth couldn’t enter the PIN. Please type it yourself.</string>
    <string name="pin_change">Change PIN</string>
    <string name="pin_close">Close</string>
</resources>
